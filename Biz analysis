_COMPETITOR_SYSTEM = "당신은 디지털 마케팅 시장 분석 전문가입니다."


def _verify_competitor_domain(domain: str) -> tuple[bool, str]:
    """
    Crawler를 재사용하여 경쟁사 도메인이 실제 운영 중인지 검증.
    반환: (is_live, evidence_title)

    검증 기준:
    - Tier 1/2 크롤 성공 + title 존재 → verified
    - Tier 3(검색 기반 추론)만 가능 → unverified (증거 약함)
    - 모든 Tier 실패 → False
    """
    with CaptureError(f"verify_domain_{domain}", log_level="info") as ctx:
        result = crawl(domain, use_cache=True)
        if result.ok and result.tier_used in (1, 2) and result.title:
            return True, result.title
        if result.ok and result.tier_used == 3:
            # Tier 3은 검색 기반 추론 — 존재 가능성 높지만 확실하지 않음
            return True, f"[검색 추론] {result.title}"
    return False, ""


def discover_competitors(
    client_gpt, client_gemini,
    biz_info: BusinessInfo,
    target_url: str,
    market_scope: str,
    model_gpt: str,
    n_competitors: int = 5,
    use_cache: bool = True,
) -> list[Competitor]:
    """
    검색 데이터 기반 경쟁사 도출 + Crawler 실도메인 검증.

    Pipeline (개선):
    1. Jina Search 다중 쿼리로 검색 데이터 수집
    2. AI로 후보 경쟁사 목록 생성 (n_competitors * 2배 요청)
    3. Crawler로 각 후보 도메인 실존 검증
    4. 검증 통과한 항목만 최종 n_competitors개 반환
    """
    try:
        p = urlparse(target_url if target_url.startswith("http") else "https://" + target_url)
        domain = p.netloc.replace("www.", "")
    except Exception:
        domain = target_url

    cache = get_cache()
    if use_cache:
        key = cache.make_key(
            "competitors", target_url, biz_info.industry, market_scope, n_competitors
        )
        cached = cache.get(key)
        if cached:
            logger.info(f"Cache HIT: competitors({domain})")
            return [Competitor(**c) for c in cached]

    scope_kw = "한국 국내" if "국내" in market_scope else "글로벌"
    scope_inst = (
        "반드시 대한민국에서 서비스 중인 국내 기업만 포함하세요. 해외 기업은 제외합니다."
        if "국내" in market_scope
        else "전 세계 글로벌 시장에서 활동하는 기업을 포함하세요."
    )

    # ── Step 1: 검색 데이터 수집 ──
    search_data = []
    for q in [
        f"{biz_info.industry} 경쟁사 {scope_kw}",
        f"{biz_info.brand_name} 대안 {biz_info.industry}",
        f"{biz_info.industry} 주요 기업 비교 {scope_kw}",
    ]:
        ctx = crawl_search(q, use_cache=use_cache)
        if ctx:
            search_data.append(f"[{q}]\n{ctx[:2000]}")

    search_section = (
        "[실제 검색 데이터 — 최우선 근거]\n" + "\n\n".join(search_data[:2])
        if search_data
        else "[검색 데이터: 없음 — AI 자체 지식으로 판단]"
    )

    # n_competitors * 2배 후보 요청 (검증 후 탈락 여유분 확보)
    candidate_count = n_competitors * 2

    prompt = f"""당신은 {biz_info.industry} 분야의 시장 분석 전문가입니다.

[분석 대상]
- 브랜드: {biz_info.brand_name}
- 도메인: {domain}
- 업종: {biz_info.industry} ({biz_info.industry_category})
- 핵심 서비스: {biz_info.core_product}
- 타겟: {biz_info.target_audience}

{search_section}

[경쟁사 선정 기준]
1. 위 검색 데이터에 등장하는 브랜드 최우선
2. {biz_info.industry}와 동일 카테고리에서 직접 경쟁
3. {biz_info.brand_name} 고객이 이탈 시 선택할 가능성 높은 대안
4. {scope_inst}
5. {domain} 자체는 절대 포함 금지
6. 가상/임시 도메인(competitor1.com 등) 사용 금지 — 반드시 실제 운영 도메인

후보 {candidate_count}개를 JSON 배열로 출력 (검증에서 일부 탈락 예정이므로 충분히 나열):
[
  {{
    "rank": 1,
    "brand_name": "브랜드명",
    "domain": "실제도메인.com",
    "reason": "경쟁 이유 20자 이내",
    "market_position": "업계 1위 | 신흥 강자 | 틈새 전문 중 택1",
    "evidence": "검색 데이터 근거 또는 AI 판단"
  }}
]"""

    result_str = ""
    with CaptureError("competitor_ai", log_level="warning"):
        if client_gpt:
            result_str = call_gpt(
                client_gpt, prompt,
                system=_COMPETITOR_SYSTEM,
                max_tokens=1500,
                model=model_gpt,
                temperature=0.2,
            )
        elif client_gemini:
            result_str = call_gemini(
                client_gemini, prompt,
                max_tokens=1500,
                temperature=0.2,
            )

    # ── Step 2: AI 응답 파싱 ──
    candidates = []
    with CaptureError("competitor_parse", log_level="warning"):
        m = re.search(r'\[.*\]', result_str, re.DOTALL)
        if m:
            raw = json.loads(m.group())
            for c in raw:
                d = c.get("domain", "").strip()
                # 명백한 가짜 도메인 1차 필터
                if (d and len(d) >= 4
                        and "competitor" not in d.lower()
                        and not re.match(r'^c\d+\.com$', d)):
                    candidates.append(c)

    # ── Step 3: Crawler 검증 레이어 ──
    verified_competitors: list[Competitor] = []

    def _verify_one(c: dict) -> Optional[Competitor]:
        d = c.get("domain", "").strip()
        if not d:
            return None
        is_live, title = _verify_competitor_domain(d)
        if not is_live:
            logger.info(f"Competitor domain failed verification: {d}")
            return None
        evidence = c.get("evidence", "")
        if title:
            evidence = f"{evidence} | 크롤 확인: {title[:40]}"
        return Competitor(
            rank=c.get("rank", 0),
            brand_name=c.get("brand_name", d),
            domain=d,
            reason=c.get("reason", ""),
            market_position=c.get("market_position", ""),
            verified=True,
            evidence=evidence,
        )

    # 병렬 검증 (최대 6 스레드)
    max_workers = min(len(candidates), 6)
    if candidates:
        with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as ex:
            futures = {ex.submit(_verify_one, c): c for c in candidates}
            for fut in concurrent.futures.as_completed(futures):
                with CaptureError("verify_future", log_level="info"):
                    comp = fut.result(timeout=30)
                    if comp:
                        verified_competitors.append(comp)
                if len(verified_competitors) >= n_competitors:
                    break  # 충분히 모였으면 조기 종료

    # rank 재정렬
    verified_competitors.sort(key=lambda x: x.rank)
    for i, comp in enumerate(verified_competitors):
        comp.rank = i + 1

    # ── 폴백: 검증 통과 0개 ──
    if not verified_competitors:
        logger.warning(f"모든 경쟁사 검증 실패, 검증 없이 AI 결과 사용: {domain}")
        for i, c in enumerate(candidates[:n_competitors]):
            verified_competitors.append(Competitor(
                rank=i + 1,
                brand_name=c.get("brand_name", f"경쟁사 {i+1}"),
                domain=c.get("domain", f"competitor{i+1}.com"),
                reason=c.get("reason", "동종 업계"),
                market_position=c.get("market_position", "시장 참여자"),
                verified=False,
                evidence="검증 미완료",
            ))

    result = verified_competitors[:n_competitors]

    if use_cache:
        key = cache.make_key(
            "competitors", target_url, biz_info.industry, market_scope, n_competitors
        )
        cache.set(key, [c.__dict__ for c in result], namespace="competitors")

    return result


