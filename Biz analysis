def _search_confirm_industry(
    client_gpt, client_gemini,
    domain: str,
    ai_industry: str,
    model_gpt: str,
) -> tuple[str, str]:
    """
    AI 추론 업종을 검색 결과로 검증·확정.
    반환: (confirmed_industry, search_evidence)

    LLM 우선순위:
      검색 근거 있음 → 검색 기반 업종 우선
      검색 근거 없음 → AI 추론 유지
    """
    stem = domain.split(".")[0]
    query = f"{stem} {ai_industry} 서비스 소개"
    search_ctx = crawl_search(query, use_cache=True)

    if not search_ctx or len(search_ctx) < 100:
        # 검색 실패 → AI 추론 그대로 사용
        return ai_industry, ""

    prompt = f"""검색 결과를 바탕으로 "{domain}"의 업종을 최종 확정하세요.

[AI 초기 추론] {ai_industry}
[검색 근거]
{search_ctx[:1500]}

규칙:
- 검색 근거가 AI 추론과 일치하면 그대로 출력
- 검색 근거가 더 구체적/정확하면 검색 기반으로 수정
- 검색 근거가 전혀 다른 업종을 가리키면 검색 근거 우선
- "IT 서비스" 같은 모호한 표현은 절대 사용 금지

JSON만 출력:
{{"industry": "확정 업종명", "evidence": "근거 한 문장"}}"""

    result_str = ""
    with CaptureError("search_confirm", log_level="warning"):
        if client_gpt:
            result_str = call_gpt(client_gpt, prompt, system=_BIZ_SYSTEM,
                                  max_tokens=120, model=model_gpt, temperature=0.1)
        elif client_gemini:
            result_str = call_gemini(client_gemini, prompt, max_tokens=120, temperature=0.1)

    with CaptureError("search_confirm_parse", log_level="warning"):
        m = re.search(r'\{.*\}', result_str, re.DOTALL)
        if m:
            parsed = json.loads(m.group())
            industry = parsed.get("industry", "").strip()
            evidence = parsed.get("evidence", "").strip()
            if industry and not any(bad in industry.lower() for bad in _BAD_INDUSTRIES):
                return industry, evidence

    return ai_industry, ""


