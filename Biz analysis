# 제거할 패턴: 네비게이션 잔재, 법적 고지, 쿠키 배너 등
_NOISE_PATTERNS = [
    r'copyright\s*©?\s*\d{4}.*',
    r'all\s+rights\s+reserved.*',
    r'privacy\s+policy.*',
    r'terms\s+(of\s+)?(service|use).*',
    r'쿠키\s*(정책|설정|동의).*',
    r'개인정보\s*(처리방침|보호정책).*',
    r'이용약관.*',
    r'사업자\s*등록번호.*',
    r'대표이사\s*:.*',
    r'로그인\s*회원가입.*',
    r'(홈|메뉴|닫기|열기|더보기)\s+(홈|메뉴|닫기|열기|더보기)',
    r'(skip\s+to|go\s+to)\s+(content|main|nav)',
    r'https?://\S+',           # URL 제거
    r'[\w.+-]+@[\w-]+\.\w+',  # 이메일 제거
    r'\d{2,4}-\d{3,4}-\d{4}', # 전화번호 제거
]

_COMPILED_NOISE = [re.compile(p, re.IGNORECASE) for p in _NOISE_PATTERNS]

# 핵심 정보를 담을 가능성이 높은 섹션 헤더 키워드
_SIGNAL_KEYWORDS = [
    "서비스", "솔루션", "플랫폼", "기능", "특징", "소개", "about",
    "product", "service", "feature", "solution", "overview",
    "우리는", "회사", "company", "brand", "we are", "we provide",
    "전문", "특화", "전략", "광고", "마케팅", "쇼핑", "배송",
]


def extract_business_text(raw_text: str, max_chars: int = 2500) -> str:
    """
    크롤 본문에서 업종 판별에 유용한 핵심 텍스트만 추출.

    전략:
    1. 노이즈 패턴(법적고지·메뉴·URL 등) 제거
    2. 토큰 기준 너무 짧은 조각(<10자) 제거
    3. 시그널 키워드 포함 문단 상위 우선 배치
    4. max_chars 이내로 잘라 반환
    """
    if not raw_text:
        return ""

    # Step 1: 노이즈 제거
    cleaned = raw_text
    for pat in _COMPILED_NOISE:
        cleaned = pat.sub("", cleaned)

    # Step 2: 문단 분리 & 짧은 조각 제거
    chunks = [c.strip() for c in re.split(r'\n{2,}|\r\n', cleaned) if len(c.strip()) >= 10]

    # Step 3: 시그널 키워드 포함 문단 앞으로
    def _signal_score(chunk: str) -> int:
        lower = chunk.lower()
        return sum(1 for kw in _signal_keywords if kw in lower)

    # 시그널 있는 문단 먼저, 나머지는 원래 순서 유지
    _signal_keywords = _SIGNAL_KEYWORDS
    scored = sorted(
        enumerate(chunks),
        key=lambda x: (-_signal_score(x[1]), x[0])
    )
    ordered = [chunk for _, chunk in scored]

    # Step 4: max_chars 이내로 결합
    result = ""
    for chunk in ordered:
        if len(result) + len(chunk) + 2 > max_chars:
            remaining = max_chars - len(result) - 2
            if remaining > 30:
                result += "\n" + chunk[:remaining]
            break
        result += "\n" + chunk

    return result.strip()


