def analyze_business(
    client_gpt, client_gemini,
    url: str,
    model_gpt: str,
    confirmed_industry: str = "",
    use_cache: bool = True,
) -> BusinessInfo:
    """
    Pipeline (개선):
    1. 3-tier 크롤링
    2. extract_business_text() — 노이즈 제거 후 핵심 추출
    3. 검색 보완 (크롤 품질 무관하게 항상 시도)
    4. 1단계 분류: 업종 대분류 (카테고리)
    5. 2단계 분류: 세부 업종 + 나머지 biz 필드
    6. 검색 기반 업종 확정 (LLM 재검증)
    7. 업종 여전히 모호 → retry
    8. 사용자 확정 업종 최우선 반영
    """
    try:
        p = urlparse(url if url.startswith("http") else "https://" + url)
        domain = p.netloc.replace("www.", "")
    except Exception:
        domain = url

    stem = domain.split(".")[0]
    cache = get_cache()

    if use_cache:
        key = cache.make_key("biz", url, confirmed_industry)
        cached = cache.get(key)
        if cached:
            logger.info(f"Cache HIT: biz_analysis({domain})")
            return BusinessInfo.from_dict(cached)

    # ── Step 1: 크롤링 ──
    crawl_result = crawl(url, use_cache=use_cache)

    # ── Step 2: 핵심 텍스트 추출 ──
    clean_text = extract_business_text(crawl_result.body_text)
    logger.info(
        f"extract_business_text: raw={len(crawl_result.body_text)}chars "
        f"→ clean={len(clean_text)}chars (tier={crawl_result.tier_used})"
    )

    # ── Step 3: 검색 보완 (크롤 품질과 무관하게 항상 시도) ──
    # 크롤 성공 여부와 관계없이 검색 데이터를 병렬로 수집
    search_ctx = ""
    with CaptureError("biz_search_supplement", log_level="info"):
        ctx1 = crawl_search(f"{stem} 서비스 업종 소개", use_cache=use_cache)
        if not ctx1 or len(ctx1) < 200:
            ctx1 = crawl_search(f"{stem} company overview service", use_cache=use_cache)
        search_ctx = ctx1

    # ── Step 4: 1단계 — 대분류 카테고리 ──
    category = _classify_category(
        client_gpt, client_gemini,
        domain, clean_text, search_ctx, model_gpt,
    )
    logger.info(f"Category classified: {category}")

    # ── Step 5: 2단계 — 세부 업종 + biz 필드 ──
    biz_dict = _classify_detail(
        client_gpt, client_gemini,
        domain, clean_text, search_ctx, category, model_gpt,
    )

    # ── Step 6: 검색 기반 업종 확정 ──
    ai_industry = biz_dict.get("industry", f"{stem} 서비스")
    confirmed, evidence = _search_confirm_industry(
        client_gpt, client_gemini,
        domain, ai_industry, model_gpt,
    )
    if confirmed != ai_industry:
        logger.info(f"Industry confirmed by search: '{ai_industry}' → '{confirmed}' ({evidence})")
    biz_dict["industry"] = confirmed

    # ── Step 7: 여전히 모호 → retry ──
    if biz_dict and any(bad in biz_dict.get("industry", "").lower() for bad in _BAD_INDUSTRIES):
        retry_prompt = f"""도메인 "{domain}"의 업종을 아래 정보로 정확히 분류하세요.
대분류: {category}
크롤 핵심: {clean_text[:800]}
검색 데이터: {search_ctx[:600] if search_ctx else '없음'}

구체적인 업종명으로만 JSON 출력 (예: {{"industry": "퍼포먼스 마케팅 광고대행사"}}):"""

        with CaptureError("biz_industry_retry", log_level="warning"):
            r2 = (
                call_gpt(client_gpt, retry_prompt, max_tokens=80, model=model_gpt, temperature=0.1)
                if client_gpt else
                call_gemini(client_gemini, retry_prompt, max_tokens=80, temperature=0.1)
            )
            m2 = re.search(r'\{.*\}', r2, re.DOTALL)
            if m2:
                new_industry = json.loads(m2.group()).get("industry", "")
                if new_industry and not any(bad in new_industry.lower() for bad in _BAD_INDUSTRIES):
                    biz_dict["industry"] = new_industry

    # 폴백
    if not biz_dict:
        biz_dict = {
            "brand_name":   stem.upper(),
            "industry":     f"{stem} 관련 서비스",
            "core_product": f"{domain} 서비스",
            "target_audience": "잠재 고객",
            "key_services": [],
            "confidence":   "low",
        }

    biz_dict["industry_category"] = category
    biz_dict["crawl_tier"] = crawl_result.tier_used

    # ── Step 8: 사용자 확정 업종 최우선 ──
    if confirmed_industry.strip():
        biz_dict["industry"] = confirmed_industry.strip()
        biz_dict["confidence"] = "high"

    biz = BusinessInfo.from_dict(biz_dict)

    if use_cache:
        key = cache.make_key("biz", url, confirmed_industry)
        cache.set(key, biz.to_dict(), namespace="biz")

    return biz


