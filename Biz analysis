_CATEGORY_LABELS = " | ".join(_INDUSTRY_CATEGORIES)


def _classify_category(
    client_gpt, client_gemini,
    domain: str,
    clean_text: str,
    search_ctx: str,
    model_gpt: str,
) -> str:
    """
    1단계: 큰 카테고리 분류.
    반환: industry_category 문자열 (예: "광고/마케팅")
    """
    prompt = f"""아래 데이터를 보고, 이 웹사이트가 속하는 가장 적합한 업종 대분류 하나만 선택하세요.

[도메인] {domain}
[본문 핵심]
{clean_text[:1200]}
[검색 보완]
{search_ctx[:600] if search_ctx else "(없음)"}

선택지 (정확히 아래 중 하나만 출력, 설명 없이):
{_CATEGORY_LABELS}"""

    result = ""
    with CaptureError("category_classify", log_level="warning"):
        if client_gpt:
            result = call_gpt(client_gpt, prompt, system=_BIZ_SYSTEM,
                              max_tokens=20, model=model_gpt, temperature=0.1)
        elif client_gemini:
            result = call_gemini(client_gemini, prompt, max_tokens=20, temperature=0.1)

    # 응답에서 유효한 카테고리 추출
    for cat in _INDUSTRY_CATEGORIES:
        if cat in (result or ""):
            return cat
    return "기타"


def _classify_detail(
    client_gpt, client_gemini,
    domain: str,
    clean_text: str,
    search_ctx: str,
    category: str,
    model_gpt: str,
) -> dict:
    """
    2단계: 세부 업종 + 나머지 biz 필드 분류.
    반환: biz_dict (brand_name, industry, core_product, ...)
    """
    detail_hints = _CATEGORY_TO_DETAIL.get(category, ["기타 서비스"])
    hints_str = ", ".join(detail_hints)

    prompt = f"""아래 데이터를 분석하여 웹사이트의 세부 업종과 서비스를 파악하세요.

[도메인] {domain}
[대분류] {category}
[세부 업종 예시 (참고만)] {hints_str}
[본문 핵심]
{clean_text[:1800]}
[검색 보완]
{search_ctx[:800] if search_ctx else "(없음)"}

[분석 지침]
- brand_name: 도메인이 아닌 실제 회사명/브랜드명
- industry: 위 예시보다 더 구체적으로 기술 가능하면 기술 (예시에 없는 표현도 가능)
  ✅ "퍼포먼스 마케팅 광고대행사", "B2B SaaS HR솔루션"
  ❌ "IT 서비스", "온라인 서비스"
- confidence: 크롤 데이터 풍부=high, 보통=medium, 부족=low
- 광고·퍼포먼스·IMC·GFA·매체 키워드 → 광고대행사 계열 우선

JSON만 출력 (다른 텍스트 없이):
{{
  "brand_name": "실제 브랜드명",
  "industry": "구체적 세부 업종",
  "core_product": "핵심 서비스/상품 한 문장",
  "target_audience": "주요 타겟 고객층",
  "key_services": ["서비스1", "서비스2", "서비스3"],
  "confidence": "high | medium | low 중 택1"
}}"""

    result_str = ""
    with CaptureError("detail_classify", log_level="warning"):
        if client_gpt:
            result_str = call_gpt(client_gpt, prompt, system=_BIZ_SYSTEM,
                                  max_tokens=400, model=model_gpt, temperature=0.15)
        elif client_gemini:
            result_str = call_gemini(client_gemini, prompt, max_tokens=400, temperature=0.15)

    biz_dict = {}
    with CaptureError("detail_json_parse", log_level="warning"):
        m = re.search(r'\{.*\}', result_str, re.DOTALL)
        if m:
            biz_dict = json.loads(m.group())

    return biz_dict


