                f"{biz_info.brand_name}에 대한 실제 사용자 평가와 주요 불만 사항은?",
                f"{biz_info.industry}에서 {biz_info.brand_name}과 직접 비교되는 대안 서비스는?",
            ]

    result = questions[:5]

    if use_cache:
        key = cache.make_key("questions", url, biz_info.industry, engine)
        cache.set(key, result, namespace="biz")

